---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<!-- 전체 사이트맵: 네이버 서치어드바이저에는 이 파일을 제출하세요 -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc><changefreq>weekly</changefreq><priority>1.0</priority></url>
  <url><loc>{{ site.url }}/info/</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
  <url><loc>{{ site.url }}/branches/</loc><changefreq>weekly</changefreq><priority>0.9</priority></url>
  <url><loc>{{ site.url }}/sitemap/</loc><changefreq>weekly</changefreq><priority>0.3</priority></url>
  <!-- 학습정보 -->
  {%- for c in collections.infoCategories %}
  <url><loc>{{ site.url }}/info/{{ c.slug }}/</loc><lastmod>{{ c.posts[0].date | dateISO }}</lastmod><priority>0.6</priority></url>
  {%- endfor %}
  {%- for p in collections.info %}
  <url><loc>{{ site.url }}{{ p.url }}</loc><lastmod>{{ (p.data.updated or p.date) | dateISO }}</lastmod><priority>0.7</priority></url>
  {%- endfor %}
  <!-- 전국지점 (지역별) -->
  {%- for r in collections.branchRegions %}
  <!-- {{ r.name }} -->
  <url><loc>{{ site.url }}/branches/{{ r.slug }}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  {%- for b in r.branches %}
  <url><loc>{{ site.url }}{{ b.url }}</loc><lastmod>{{ (b.data.updated or b.date) | dateISO }}</lastmod><priority>0.8</priority></url>
  {%- endfor %}
  {%- endfor %}
</urlset>

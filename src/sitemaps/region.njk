---
pagination:
  data: collections.branchRegions
  size: 1
  alias: r
permalink: "/sitemaps/branches-{{ r.slug }}.xml"
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- if r.realCount %}
  <url><loc>{{ site.url }}/branches/{{ r.slug }}/</loc><changefreq>weekly</changefreq><priority>0.8</priority></url>
  {%- endif %}
  {%- for b in r.real %}
  <url><loc>{{ site.url }}{{ b.url }}</loc><lastmod>{{ (b.data.updated or b.date) | dateISO }}</lastmod><priority>0.8</priority></url>
  {%- endfor %}
</urlset>

---
permalink: /sitemap-index.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<!-- 사이트맵 묶음: 구글 서치콘솔용. 지역별로 나뉘어 있습니다 (예시 지점만 있는 지역은 제외) -->
<sitemapindex xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <sitemap><loc>{{ site.url }}/sitemaps/info.xml</loc></sitemap>
  {%- for r in collections.branchRegions %}{% if r.realCount %}
  <sitemap><loc>{{ site.url }}/sitemaps/branches-{{ r.slug }}.xml</loc></sitemap>
  {%- endif %}{% endfor %}
</sitemapindex>

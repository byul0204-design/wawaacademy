{#  사용법: {% set fixedBranch = "해운대점" %}{% include "partials/consult.njk" %}
    fixedBranch 가 있으면 지점 선택칸 대신 숨은 값으로 들어갑니다. #}
<form class="consult" id="consult" name="consult" method="POST" action="/thanks/"
      data-netlify="true" netlify-honeypot="company">
  <h2>상담 신청</h2>
  <p class="c-lead">남겨 주시면 {% if fixedBranch %}{{ fixedBranch }}에서{% else %}고르신 센터에서{% endif %} 하루 안에 연락드립니다. 방문 상담 때는 학습 성향 진단을 함께 해 드립니다.</p>
  <input type="hidden" name="form-name" value="consult">
  <p class="hp"><label>회사명 <input name="company" tabindex="-1" autocomplete="off"></label></p>

  {% if fixedBranch %}
    <input type="hidden" name="branch" value="{{ fixedBranch }}">
  {% else %}
  <div class="f-row">
    <label for="f-branch">희망 센터</label>
    <select id="f-branch" name="branch" required>
      <option value="">센터를 골라 주세요</option>
      {% for r in collections.branchRegions %}
      <optgroup label="{{ r.name }}">
        {% for b in r.branches %}<option>{{ b.data.branchName }}</option>{% endfor %}
      </optgroup>
      {% endfor %}
      <option>잘 모르겠어요 (가까운 곳 추천)</option>
    </select>
  </div>
  {% endif %}

  <div class="f-2">
    <div class="f-row">
      <label for="f-name">학부모 성함</label>
      <input id="f-name" name="parent" required autocomplete="name">
    </div>
    <div class="f-row">
      <label for="f-tel">연락처</label>
      <input id="f-tel" name="phone" type="tel" required inputmode="tel" autocomplete="tel" placeholder="010-0000-0000">
    </div>
  </div>
  <div class="f-2">
    <div class="f-row">
      <label for="f-grade">자녀 학년</label>
      <select id="f-grade" name="grade" required>
        <option value="">골라 주세요</option>
        {% for g in ["초1","초2","초3","초4","초5","초6","중1","중2","중3","고1","고2","고3"] %}<option>{{ g }}</option>{% endfor %}
      </select>
    </div>
    <div class="f-row">
      <label for="f-school">다니는 학교</label>
      <input id="f-school" name="school" placeholder="선택 사항">
    </div>
  </div>
  <fieldset class="f-row">
    <legend>상담 방식</legend>
    <label class="radio"><input type="radio" name="type" value="전화 상담" checked> 전화 상담</label>
    <label class="radio"><input type="radio" name="type" value="방문 상담"> 방문 상담</label>
  </fieldset>
  <div class="f-row">
    <label for="f-msg">궁금한 점</label>
    <textarea id="f-msg" name="message" rows="3" placeholder="선택 사항"></textarea>
  </div>

  <details class="privacy">
    <summary>개인정보 수집·이용 안내</summary>
    <p>상담 연락을 위해 학부모 성함, 연락처, 자녀 학년, 학교, 희망 센터를 받습니다. 신청일로부터 2개월 동안 보관한 뒤 파기합니다.
      동의하지 않으실 수 있지만, 그 경우 상담 연락을 드릴 수 없습니다.</p>
  </details>
  <label class="check"><input type="checkbox" name="agree" required> 개인정보 수집·이용에 동의합니다</label>
  <label class="check"><input type="checkbox" name="age14" required> 신청자는 만 14세 이상입니다</label>
  <button class="btn btn-wide" type="submit">상담 신청 보내기</button>
</form>

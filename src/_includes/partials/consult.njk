{#  상담 연결 패널
    사용법: {% set fixedBranch = "해운대점" %}{% include "partials/consult.njk" %}
    fixedBranch 가 있으면 문자 내용에 그 센터 이름이 미리 들어갑니다. #}
{% set telNum = phone or site.phone %}
{% set smsBody = "[와와 상담 문의]\n센터: " + (fixedBranch or "") + "\n자녀 학년: \n다니는 학교: \n문의 내용: " %}
<div class="contact" id="consult">
  <h2>상담 문의</h2>
  <p class="c-lead">
    궁금한 점을 편하게 물어보세요.
    {% if fixedBranch %}{{ fixedBranch }}에서{% else %}가까운 센터에서{% endif %}
    아이 학년과 학교에 맞춰 안내해 드립니다.
  </p>

  <div class="c-ways">
    <a class="c-way c-way-call" href="{{ telNum | tel }}">
      <span class="c-ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M6.6 3.5h-2a1.5 1.5 0 0 0-1.5 1.7c.5 4 2.3 7.7 5.2 10.5s6.5 4.7 10.5 5.2a1.5 1.5 0 0 0 1.7-1.5v-2a1.5 1.5 0 0 0-1.3-1.5c-1-.1-2-.4-2.9-.7a1.5 1.5 0 0 0-1.6.3l-.9.9a12 12 0 0 1-5-5l.9-.9a1.5 1.5 0 0 0 .3-1.6c-.3-.9-.6-1.9-.7-2.9a1.5 1.5 0 0 0-1.7-1.3z"/>
        </svg>
      </span>
      <strong>전화 상담</strong>
      <em>{{ telNum }}</em>
      <span class="c-sub">누르면 바로 연결됩니다</span>
    </a>

    <a class="c-way c-way-sms" href="sms:{{ telNum | telNumber }}?body={{ smsBody | urlencode }}">
      <span class="c-ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 9.5 9.5 0 0 1-2.8-.4L3 21l1.6-4.6A8.3 8.3 0 0 1 3.5 11 8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5z"/>
        </svg>
      </span>
      <strong>문자 상담</strong>
      <em>통화가 어려우실 때</em>
      <span class="c-sub">내용이 미리 채워집니다</span>
    </a>

    {% if site.kakao %}
    <a class="c-way c-way-kakao" href="{{ site.kakao }}" rel="noopener">
      <span class="c-ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 3.5c-4.7 0-8.5 2.9-8.5 6.5 0 2.3 1.6 4.4 4 5.6l-.9 3.4 3.7-2.2c.6.1 1.1.1 1.7.1 4.7 0 8.5-2.9 8.5-6.5S16.7 3.5 12 3.5z"/>
        </svg>
      </span>
      <strong>카카오톡</strong>
      <em>채널로 문의</em>
      <span class="c-sub">편한 시간에 남겨 주세요</span>
    </a>
    {% endif %}
  </div>

  <div class="c-note">
    <p class="c-note-t">문자로 남기실 때 이렇게 적어 주시면 빠릅니다</p>
    <ul>
      <li>자녀 학년과 다니는 학교</li>
      <li>고민되는 과목이나 상황</li>
      <li>연락 받기 편한 시간</li>
    </ul>
  </div>

  {% if site.hours %}<p class="c-hours">상담 가능 시간 {{ site.hours }}</p>{% endif %}
</div>
